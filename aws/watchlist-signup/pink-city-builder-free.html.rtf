    <script>\
        let funds = 100, solar = 0, spcx = 0, rovers = 0, cats = 0, multiplier = 1;\
        let totalPower = 0, totalSPCX = 0, totalCAT = 0;\
        let buildings = [];\
\
        function updateUI() \{\
            document.getElementById('funds').textContent = Math.floor(funds);\
            document.getElementById('solar').textContent = Math.floor(solar);\
            document.getElementById('spcx').textContent = Math.floor(spcx);\
            document.getElementById('rover-count').textContent = rovers + " owned";\
            document.getElementById('cat-count').textContent = cats + " owned";\
            document.getElementById('rover-cost').textContent = Math.ceil(50 * Math.pow(1.15, rovers));\
            document.getElementById('cat-cost').textContent = Math.ceil(30 * Math.pow(1.15, cats));\
            document.getElementById('solar-cost').textContent = Math.ceil(100 * Math.pow(1.2, buildings.filter(b=>b==='solar').length));\
            document.getElementById('hub-cost').textContent = Math.ceil(200 * Math.pow(1.2, buildings.filter(b=>b==='hub').length));\
            document.getElementById('total-power').textContent = Math.floor(totalPower) + " MW";\
            document.getElementById('total-spcx').textContent = Math.floor(totalSPCX);\
            document.getElementById('total-cat').textContent = Math.floor(totalCAT);\
        \}\
\
        function addBuilding(type) \{\
            const grid = document.getElementById('city-grid');\
            const b = document.createElement('div');\
            b.className = 'building';\
            b.style.left = (Math.random() * 75 + 12) + '%';\
            b.style.top = (Math.random() * 65 + 15) + '%';\
            b.textContent = type === 'solar' ? '\uc0\u9728 \u65039 ' : '\u55357 \u57072 \u65039 ';\
            grid.appendChild(b);\
            buildings.push(type);\
        \}\
\
        function buyUnit(type) \{\
            if (type === 'rover') \{\
                const cost = Math.ceil(50 * Math.pow(1.15, rovers));\
                if (funds >= cost) \{ funds -= cost; rovers++; totalSPCX += 5; \}\
            \} else \{\
                const cost = Math.ceil(30 * Math.pow(1.15, cats));\
                if (funds >= cost) \{ funds -= cost; cats++; totalCAT += 3; \}\
            \}\
            updateUI();\
        \}\
\
        function buildStructure(type) \{\
            let cost = type === 'solar-farm' ? Math.ceil(100 * Math.pow(1.2, buildings.filter(b=>b==='solar').length)) : Math.ceil(200 * Math.pow(1.2, buildings.filter(b=>b==='hub').length));\
            if (funds >= cost) \{\
                funds -= cost;\
                if (type === 'solar-farm') \{\
                    solar += 25; totalPower += 25;\
                    addBuilding('solar');\
                \} else \{\
                    spcx += 10; totalSPCX += 15;\
                    addBuilding('hub');\
                \}\
            \}\
            updateUI();\
        \}\
\
        function buyUpgrade(type) \{\
            if (type === 'neon' && funds >= 500) \{\
                funds -= 500; multiplier = 1.5;\
                document.getElementById('upgrade-neon').style.opacity = '0.5';\
                alert("\uc0\u55356 \u57144  NEON PINK BOOST ACTIVATED!");\
            \} else if (type === 'butterfly' && funds >= 1200) \{\
                funds -= 1200; multiplier = 2.5;\
                document.getElementById('upgrade-butterfly').style.opacity = '0.5';\
                alert("\uc0\u55358 \u56715  BUTTERFLY TATTOO AURA UNLOCKED!");\
            \}\
            updateUI();\
        \}\
\
        function cityClick(e) \{\
            if (Math.random() < 0.4) \{\
                funds += 12;\
                const s = document.createElement('div');\
                s.className = 'sparkle';\
                s.textContent = '\uc0\u55357 \u56462 ';\
                s.style.left = e.offsetX + 'px';\
                s.style.top = e.offsetY + 'px';\
                document.getElementById('city-grid').appendChild(s);\
                setTimeout(() => s.remove(), 1200);\
                updateUI();\
            \}\
        \}\
\
        function gameLoop() \{\
            funds += (rovers * 1.2 + cats * 0.9) * multiplier * 0.7;\
            solar += cats * 2 * multiplier * 0.08;\
            spcx += rovers * 0.7 * multiplier * 0.1;\
            totalPower = solar;\
            totalSPCX += rovers * 0.04;\
            totalCAT += cats * 0.07;\
            updateUI();\
        \}\
\
        function resetGame() \{\
            if (confirm("Reset Pink Empire?")) location.reload();\
        \}\
\
        // Auto save / load\
        window.onload = () => \{\
            const saved = localStorage.getItem('pinkEmpireFree');\
            if (saved) \{\
                const d = JSON.parse(saved);\
                Object.assign(window, d);\
            \}\
            updateUI();\
            setInterval(() => \{\
                gameLoop();\
                localStorage.setItem('pinkEmpireFree', JSON.stringify(\{funds, solar, spcx, rovers, cats, multiplier, totalPower, totalSPCX, totalCAT, buildings\}));\
            \}, 900);\
        \};\
    </script>\
